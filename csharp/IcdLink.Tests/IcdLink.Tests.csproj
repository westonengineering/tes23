<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>..\..\bin\$(Configuration)\tests\$(TargetFramework)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IcdLink.Net\IcdLink.Net.csproj" />
    <None Include="..\..\bin\$(Configuration)\IcdLink.dll" Link="IcdLink.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\bin\$(Configuration)\IcdLink.dll')" />
  </ItemGroup>
</Project>
