<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LargeGui</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>..\..\bin\large\gui\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\csharp\IcdLink.Net\IcdRuntime.cs" />
    <Compile Include="generated\IcdMessages.g.cs" />
    <Compile Include="generated\TestGui\*.cs" />
    <None Include="..\..\bin\large\IcdLink.dll" Link="IcdLink.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
