<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <OutputPath>..\..\bin\$(Configuration)\gui\$(TargetFramework)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\csharp\IcdLink.Net\IcdLink.Net.csproj" />
    <None Include="..\..\bin\$(Configuration)\IcdLink.dll" Link="IcdLink.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\bin\$(Configuration)\IcdLink.dll')" />
  </ItemGroup>
</Project>
